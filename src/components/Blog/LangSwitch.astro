---
interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const base = "/me";
---

{
  currentLang === "es" ? (
    <a href={`${base}/blog/en`}>Read in English</a>
  ) : (
    <a href={`${base}/blog/es`}>Leer en Español</a>
  )
}

<style>
  a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  a:hover {
    border-bottom-color: currentColor;
  }
</style>

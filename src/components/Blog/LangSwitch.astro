---
interface Props {
  slug: string;
  currentLang: string;
  otherLang: string | null;
}

const { slug, currentLang, otherLang } = Astro.props;
const base = "/me";
---

<style>
  .lang-switch {
    text-align: right;
    font-size: 0.85em;
    margin-bottom: 1em;
  }

  .lang-switch a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .lang-switch a:hover {
    border-bottom-color: currentColor;
  }

  .disabled {
    color: var(--color-texts-light);
  }
</style>

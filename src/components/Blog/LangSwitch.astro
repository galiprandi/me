---
interface Props {
  currentLang: string;
  slug?: string;
  otherLang?: string | null;
}

const { currentLang, slug, otherLang } = Astro.props;
const base = "/me";
const href =
  slug && otherLang
    ? `${base}/blog/${slug}/${otherLang}`
    : currentLang === "es"
      ? `${base}/blog/en`
      : `${base}/blog/es`;
const text = currentLang === "es" ? "Read in English" : "Leer en Español";
---

<a href={href}>{text}</a>

<style>
  a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  a:hover {
    border-bottom-color: currentColor;
  }
</style>

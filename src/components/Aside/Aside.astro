---
import Certificates from "./Certificates.astro";
import Contact from "./Contact.astro";
import Skills from "./Skills.astro";
import TechStack from "./TechStack.astro";
import PersonalBlog from "./PersonalBlog.astro";
import Languages from "./Languages.astro";
---

<aside>
  <Contact />
  <PersonalBlog />
  <Skills />
  <TechStack />
  <Languages />
  <Certificates />
</aside>

<style>
  aside {
    display: flex;
    flex-direction: column;
    gap: 1.3em;
  }

  aside a {
    word-break: break-word;
    hyphens: auto;
  }

  /* Print styles */
  @media only print {
    aside {
      gap: 0.3em;
    }
  }
</style>

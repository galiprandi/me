---
import IconPause from './Icons/IconPause.astro'
import IconPodcast from './Icons/IconPodcast.astro'
import { base } from '../utils/url'
---

<button class="container no-print" aria-label="Play podcast summary" title="Hear about me">
  <IconPodcast class="play-icon" aria-hidden="true" />
  <IconPause class="pause-icon" aria-hidden="true" />
  <audio controls style="display: none" id="podcast-audio">
    <source src={`${base}/podcast.mp3`} type="audio/mpeg" />
  </audio>

  <script>
    const container = document.querySelector('.container') as HTMLButtonElement
    const audio = document.getElementById('podcast-audio') as HTMLAudioElement

    if (container && audio) {
      const playLabel = 'Play podcast summary'
      const pauseLabel = 'Pause podcast summary'

      container.addEventListener('click', () => {
        if (audio.paused) {
          audio.play()
        } else {
          audio.pause()
        }
      })

      audio.addEventListener('play', () => {
        container.classList.add('playing')
        container.setAttribute('aria-label', pauseLabel)
      })

      audio.addEventListener('pause', () => {
        container.classList.remove('playing')
        container.setAttribute('aria-label', playLabel)
      })

      audio.addEventListener('ended', () => {
        container.classList.remove('playing')
        container.setAttribute('aria-label', playLabel)
      })
    }
  </script>

  <style>
    .container {
      position: fixed;
      bottom: 3em;
      right: 3em;
      background-color: light-dark(#727070, white);
      color: light-dark(white, black);
      border-radius: 20%;
      width: 3.5em;
      height: 3em;
      display: grid;
      place-content: center;
      cursor: pointer;
      opacity: 1;
      transition: all 0.3s;
      border: none;
      padding: 0;

      &:hover {
        opacity: 0.8;
      }

      &:focus-visible {
        outline: 2px solid light-dark(#000, #fff);
        outline-offset: 4px;
      }

      &.playing {
        .play-icon {
          display: none;
        }
        & .pause-icon {
          display: block;
        }
      }

      &:not(.playing) {
        & > .play-icon {
          display: block;
        }
        & > .pause-icon {
          display: none;
        }
      }
    }

    @media only print {
      .container {
        display: none;
      }
    }
  </style>
</button>

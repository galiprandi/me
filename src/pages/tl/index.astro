---
const target = "/me/";

export function GET() {
  return new Response(null, {
    status: 301,
    headers: { Location: target },
  });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/me/" />
    <title>Redirecting to /</title>
  </head>
  <body>
    <p>Redirecting to <a href="/me/">/</a>…</p>
  </body>
</html>

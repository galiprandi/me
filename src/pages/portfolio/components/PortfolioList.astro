---
import PortfolioItem from "./PortfolioItem.astro";
---

<section class="portfolio">
  <h3 class="upper">Portfolio</h3>
  <div class="portfolio-grid">
    <PortfolioItem
      title="AI Workflow MCP"
      description="MCP server that enables AI-powered development workflows, including Jira task bootstrapping and agent orchestration. Built with the official Model Context Protocol SDK on Express."
      techs={[
        "TypeScript",
        "Express",
        "MCP",
        "AI",
        "Jira",
        "Docker",
        "Open Source",
      ]}
      linkName="View Repository"
      repo="https://github.com/galiprandi/ai-workflow-mcp"
    />

    <PortfolioItem
      title="fastify-lm"
      description="Fastify plugin that simplifies integration with multiple language model (LM) providers including OpenAI, Google Gemini, DeepSeek, and Claude. Standardizes LLM adoption in the Fastify ecosystem."
      techs={["JavaScript", "Fastify", "OpenAI", "NPM", "Open Source", "AI"]}
      linkName="View on NPM"
      link="https://www.npmjs.com/package/fastify-lm"
      repo="https://github.com/galiprandi/fastify-lm#readme"
    />

    <PortfolioItem
      title="Smart Doc"
      description="GitHub Action that automatically updates documentation using AI with context from Jira & Clickup tickets. Change-driven, stack-aware, and PR-first for seamless CI/CD integration."
      techs={[
        "Shell",
        "GitHub Actions",
        "AI",
        "OpenAI",
        "Documentation",
        "CI/CD",
      ]}
      linkName="View Repository"
      repo="https://github.com/galiprandi/smart-doc"
    />

    <PortfolioItem
      title="MCP vs Function Calling"
      description="Comparative research on AI communication patterns. Interactive presentation exploring MCP Server vs Function Calling as complementary patterns in AI agent systems."
      techs={["Vue", "AI", "MCP", "Research", "Presentation"]}
      linkName="View Presentation"
      link="https://galiprandi.github.io/mcp-vs-fnc"
      repo="https://github.com/galiprandi/mcp-vs-fnc"
    />

    <PortfolioItem
      title="Prompt Engineering Guide"
      description="Interactive presentation on prompt engineering techniques and frameworks for technical teams. Covers Zero-shot, Few-shot, Chain-of-Thought, RAG, and the CRTR framework for scalable prompts."
      techs={["AI", "Prompt Engineering", "LLM", "Presentation", "Education"]}
      linkName="View Presentation"
      link="https://galiprandi.github.io/prompt-engineering"
      repo="https://github.com/galiprandi/mcp-vs-fnc"
    />

    <PortfolioItem
      title="deasinlimites.com"
      description="An inclusive web app designed to empower children with Down syndrome through interactive and accessible educational content. Built with a focus on UX, accessibility, and real impact."
      techs={[
        "Next.js",
        "TailwindCSS",
        "Shadcn/UI",
        "Accessibility",
        "Responsive Design",
      ]}
      linkName="Visit"
      link="https://deasinlimites.com"
      repo="https://github.com/galiprandi/deasinlimites"
    />

    <PortfolioItem
      title="array-tools"
      description="An open-source powerful and lightweight utility library that enables SQL-like operations on JavaScript arrays."
      techs={[
        "JavaScript",
        "Functional Programming",
        "NPM",
        "Open Source",
        "Lightweight",
      ]}
      linkName="View on NPM"
      link="https://www.npmjs.com/package/@galiprandi/array-tools"
      repo="https://github.com/galiprandi/array-tools#readme"
    />

    <PortfolioItem
      title="react-tools"
      description="An open-source utility library designed to simplify React development by offering reusable components and hooks. It enhances developer productivity with TypeScript integration and built-in testing utilities."
      techs={[
        "React",
        "TypeScript",
        "NPM",
        "Vitest",
        "CI/CD",
        "GitFlow",
        "GitHub Actions",
      ]}
      linkName="View on NPM"
      link="https://www.npmjs.com/package/@galiprandi/react-tools"
      repo="https://github.com/galiprandi/react-tools#readme"
    />

    <PortfolioItem
      title="Code Snapshots"
      description="A podcast series delivering concise 15-minute episodes focused on modern development practices and cutting-edge technologies. Available on major platforms, it aims to inspire and inform developers with actionable insights."
      techs={[
        "YouTube",
        "Podcast Tools",
        "Audacity",
        "Tech",
        "Management",
        "Tools",
      ]}
      linkName="Watch on YouTube"
      link="https://www.youtube.com/channel/UCCodeSnapshots"
      repo="https://github.com/galiprandi/code-snapshots#readme"
    />

    <PortfolioItem
      title="Tabata Timer"
      description="A Progressive Web App (PWA) tailored for interval-based Tabata workouts. It features an intuitive UI, offline capabilities, and responsive design to provide a seamless user experience."
      techs={["Astro", "TypeScript", "PWA", "Vite"]}
      linkName="Try it out"
      link="https://galiprandi.github.io/tabata"
      repo="https://github.com/galiprandi/tabata-timer#readme"
      className="no-print"
    />

    <PortfolioItem
      title="CSS Toolset"
      description="A versatile collection of CSS utilities and tools designed for modern web development. It includes responsive design helpers and GitHub Actions for streamlined deployments."
      techs={["CSS", "GitHub Actions", "PostCSS"]}
      repo="https://github.com/galiprandi/css-toolset#readme"
    />

    <PortfolioItem
      title="Sustainable Cities"
      description="Sustainable Cities is a project that seeks to consolidate individual mobility, focusing on the bicycle, as the axis of a new socio-cultural order that promotes the sustainability of cities and re-adapts their spaces for the benefit of their inhabitants."
      techs={["React", "TailwindCSS", "GitHub Pages"]}
      linkName="Read about it"
      link="https://galiprandi.github.io/ciudades-sostenibles/"
      repo="https://github.com/galiprandi/sustainable-cities#readme"
      className="no-print"
    />

    <PortfolioItem
      title="Event Manager"
      description="A dynamic web application for organizing and managing events. It includes real-time updates, collaborative features, and a user-friendly interface for efficient event management."
      techs={["React", "Node.js", "Express", "MongoDB"]}
      repo="https://github.com/galiprandi/event-manager#readme"
    />

    <PortfolioItem
      title="Meta Tag Generator"
      description="A straightforward tool for creating SEO-optimized meta tags. It offers live previews, practical recommendations, and a clean UI for easy usage."
      techs={["HTML", "CSS", "JavaScript", "Webpack"]}
      linkName="Try it out"
      link="https://galiprandi.github.io/meta-tag-generator"
      repo="https://github.com/galiprandi/meta-tag-generator#readme"
    />
  </div>
</section>

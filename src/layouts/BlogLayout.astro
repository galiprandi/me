---
import "@fontsource-variable/montserrat";
import "../styles/global.css";

import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  lang?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  ogImage?: string;
}

const {
  title,
  description,
  lang = "es",
  pubDate,
  updatedDate,
  tags = [],
  ogImage,
} = Astro.props;

const site = "https://galiprandi.github.io";
const base = "/me";
const canonical = `${site}${Astro.url.pathname}`;
const rssPath = lang === "en" ? "/blog/rss-en.xml" : "/blog/rss-es.xml";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title} — Germán Aliprandi</title>
    <meta name="description" content={description} />
    <meta name="author" content="Germán A. Aliprandi" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <meta property="og:image" content={`${site}${base}${ogImage}`} />
      )
    }
    {
      pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )
    }
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <meta name="twitter:image" content={`${site}${base}${ogImage}`} />
      )
    }

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`RSS ${lang.toUpperCase()}`}
      href={`${base}${rssPath}`}
    />

    <script is:inline src={`${base}/googleTag.js`}></script>
  </head>
  <body class="blog">
    <Header author="Germán A. Aliprandi" role="Personal Blog" />
    <nav class="blog-nav">
      <a href={`${base}/`}>
        {lang === "es" ? "Acerca de mí" : "About me"}
      </a>
      <span class="separator">·</span>
      <a href={`${base}/blog/${lang}`}>
        {lang === "es" ? "Blog" : "Blog"}
      </a>
      <span class="spacer"></span>
      {
        lang === "es" ? (
          <a href={`${base}/blog/en`}>Read in English</a>
        ) : (
          <a href={`${base}/blog/es`}>Leer en Español</a>
        )
      }
    </nav>
    <main>
      {
        updatedDate && (
          <small class="light">
            Última actualización:{" "}
            {updatedDate.toLocaleDateString("es-ES", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </small>
        )
      }
      <slot />
    </main>
  </body>
</html>

<style>
  body.blog {
    max-width: 720px;
    padding: 0 1.5em 3em;
    margin: 0 auto;
  }

  .blog-nav {
    display: flex;
    gap: 0.5em;
    align-items: center;
    justify-content: space-between;
    padding: 1em 0;
    border-bottom: 1px solid light-dark(#ddd, #444);
    margin-bottom: 2em;
    font-size: 0.9em;
    color: var(--color-texts-light);
  }

  .blog-nav .spacer {
    flex: 1;
  }

  .blog-nav .separator {
    color: var(--color-texts-light);
    opacity: 0.5;
  }

  .blog-nav a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .blog-nav a:hover {
    border-bottom-color: currentColor;
  }

  main {
    line-height: 1.7;
  }
</style>
